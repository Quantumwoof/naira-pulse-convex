# Naira Pulse Convex — copy to .env.local (never commit secrets)

# Default ON: use Firecrawl/OpenAI fixtures so the app runs without API keys.
DEMO_MODE=1

# From `npx convex dev` (required for live reactive backend)
NEXT_PUBLIC_CONVEX_URL=

# Optional — set DEMO_MODE=0 and provide this for live Firecrawl scrapes
# Free signup at https://www.firecrawl.dev (hackathon code MODERNSTACK may grant credits)
FIRECRAWL_API_KEY=

# Optional — short AI tip; without it, canned DEMO tips are used
OPENAI_API_KEY=

# Convex dashboard env (set via `npx convex env set`, not usually in .env.local):
# DEMO_MODE, FIRECRAWL_API_KEY, OPENAI_API_KEY on the Convex deployment
